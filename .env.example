TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Comma-separated Telegram user IDs allowed to use the bot. Empty = nobody.
# Message the bot once and it replies with your ID.
ALLOWED_USER_IDS=

# thebooleanjulian-llm gateway service key for "card-connect"
# (mint with `node scripts/new-service-key.mjs card-connect` in thebooleanjulian-llm)
LLM_GATEWAY_KEY=
# Defaults to https://llm.thebooleanjulian.dev if omitted
LLM_GATEWAY_URL=https://llm.thebooleanjulian.dev

# Optional: Serper.dev Google Search key for contact research (free tier: 2,500 queries).
# Leave blank and intel is inferred from the card alone.
SERPER_API_KEY=

# Optional: Google account linking (see README > Google Contacts setup).
# Run `python authorize_google.py` once locally to generate token.json, then
# either leave token.json next to the bot or paste its contents here for
# hosts where writing a persistent file is inconvenient.
GOOGLE_TOKEN_JSON=
GOOGLE_TOKEN_PATH=token.json

# Reminders: one run a day at REMINDER_HOUR:00 in TIMEZONE
TIMEZONE=Asia/Singapore
REMINDER_HOUR=9

# Storage (optional overrides — sensible defaults if unset)
CARD_CONNECT_DB_PATH=card_connect.db
CARD_CONNECT_PERSISTENCE_PATH=card_connect_persistence.pickle
