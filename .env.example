TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Unified key from your self-hosted FreeLLMAPI dashboard (https://github.com/tashfeenahmed/freellmapi)
FREELLMAPI_API_KEY=freellmapi-your-unified-key
# Defaults to http://localhost:3001/v1 if omitted; override if the proxy runs elsewhere
FREELLMAPI_BASE_URL=http://localhost:3001/v1
# "auto" uses the router's fallback chain; set to a specific vision-capable model id to pin it
FREELLMAPI_MODEL=auto

# Google account linking (see README > Google Contacts setup):
# Run `python authorize_google.py` once locally to generate token.json, then
# either leave token.json next to the bot or paste its contents here for
# hosts where writing a persistent file is inconvenient.
GOOGLE_TOKEN_JSON=
GOOGLE_TOKEN_PATH=token.json
